# Server
PORT=3000
NODE_ENV=development

# Database
DATABASE_URL=postgres://postgres:postgres@localhost:5433/sofi_tutor

# Auth
COOKIE_SECRET=change-me-to-a-long-random-string-32-chars-min
SESSION_COOKIE_NAME=sofi_session
SOFI_COOKIE_NAME=sofi_device
PARENT_COOKIE_MAX_DAYS=30
SOFI_COOKIE_MAX_DAYS=90

# Base URL (used to build magic-link URLs)
APP_BASE_URL=http://localhost:3000

# Groq LLM (used to generate topic content)
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile

# ElevenLabs TTS (used for voice with word-level timing).
# Si está vacío, el frontend usa Web Speech del browser (fallback).
# El audio descargado se cachea en DB (tabla tts_cache) — solo se gasta el
# free tier (10k chars/mes) la primera vez que se sintetiza cada texto.
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=EXAVITQu4vr4xnSDxMaL
ELEVENLABS_MODEL=eleven_multilingual_v2

# Single tenant: email autorizado para crear cuenta de Papá
PARENT_EMAIL=facuompre@gmail.com
